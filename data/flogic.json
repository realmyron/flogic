   "name": "Environment 1",
   "nodes": [
    {
     "id": "nbn4b018o1",
     "type": "title",
     "x": -216,
     "y": -648,
     "w": 480,
     "color": "default",
     "tag": "Start here",
     "title": "Welcome to Flogic",
     "subtitle": "Flow + logic. Right-click anywhere on the board to add a node, then drag from the dots on its sides to connect ideas.",
     "blocks": []
    },
    {
     "id": "n1izrvv8o1",
     "type": "note",
     "x": -600,
     "y": -240,
     "w": 336,
     "color": "default",
     "tag": "Blocks",
     "title": "Build notes from blocks",
     "subtitle": "",
     "blocks": [
      {
       "id": "b226i2g8o1",
       "kind": "text",
       "text": "Every node has a + in its corner. Use it to add text, highlights, categories, scenarios, checklists, images and sources."
      },
      {
       "id": "bxurqdl8o1",
       "kind": "highlight",
       "label": "Tip",
       "text": "Double-click any text to edit it."
      },
      {
       "id": "byb8smf8o1",
       "kind": "category",
       "label": "Move things",
       "text": "Grab the 6-dot handle beside a block to reorder it, drop it into another node, or pull it onto the board."
      },
      {
       "id": "bpofwxf8o1",
       "kind": "conclusion",
       "label": "Conclusion",
       "text": "Everything snaps to the grid so the board stays tidy. Hold Ctrl to place freely."
      }
     ]
    },
    {
     "id": "ne5tzsd8o1",
     "type": "note",
     "x": -144,
     "y": 68,
     "w": 336,
     "color": "violet",
     "tag": "Scenarios",
     "title": "Unroll a chain of events",
     "subtitle": "",
     "blocks": [
      {
       "id": "bih7hyk8o1",
       "kind": "text",
       "text": "Scenarios fold up so a node stays compact. Open one to see how it plays out."
      },
      {
       "id": "b78ta4c8o1",
       "kind": "scenarios",
       "label": "What could happen",
       "items": [
        {
         "id": "s3gfakc8o1",
         "title": "The idea holds up",
         "steps": [
          {
           "id": "tm3oq4j8o1",
           "label": "First",
           "text": "You sketch it on the board.",
           "alt": false
          },
          {
           "id": "tykze4r8o1",
           "label": "Then",
           "text": "Connections show how each part leads to the next.",
           "alt": false
          },
          {
           "id": "t50maqu8o1",
           "label": "Result",
           "text": "The argument reads top to bottom.",
           "alt": false
          }
         ]
        },
        {
         "id": "sngla1v8o1",
         "title": "Someone pushes back",
         "steps": [
          {
           "id": "t1tbo608o1",
           "label": "They say",
           "text": "This step does not follow.",
           "alt": true
          },
          {
           "id": "tuk1bb98o1",
           "label": "You answer",
           "text": "Add a sub-note with the missing link and a source.",
           "alt": false
          }
         ]
        }
       ]
      }
     ]
    },
